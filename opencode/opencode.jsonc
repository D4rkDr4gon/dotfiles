{
  "$schema": "https://opencode.ai/config.json",
  "skills": {
    "paths": ["/home/lcampassi/MY-AGENT-SKILLS/SKILLS"]
  },
  "agent": {
    "build": { "color": "#c62828" },
    "plan": { "color": "#8e1a1a" },
    "general": { "color": "#c5c8c6" },
    "explore": { "color": "#c62828" }
  },

  // ── Modelo principal ─────────────────────────────────────
  // "model": "ollama/qwen2.5:7b",
  // "small_model": "ollama/qwen3:1.7b",

  // ── Ollama como provider (modelos locales) ──────────────
  // Los modelos deben declararse explícitamente en "models".
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen2.5:7b": {
          "name": "Qwen 2.5 7B (local)",
          "limit": {
            "context": 32768,
            "output": 8192
          }
        },
        "qwen3:1.7b": {
          "name": "Qwen 3 1.7B (local)",
          "limit": {
            "context": 32768,
            "output": 4096
          }
        },
        "jimscard/whiterabbit-neo:latest": {
          "name": "WhiteRabbit-Neo 13B (local)",
          "limit": {
            "context": 8192,
            "output": 4096
          }
        }
      }
    }
  },

  "mcp": {
    // ── Obsidian (MCP nativo vía obsidian-local-rest-api) ────
    // Requiere plugin "obsidian-local-rest-api" (coddingtonbear) instalado.
    // API key disponible como $OBSIDIAN_API_KEY en ~/.zshenv.
    "obsidian": {
      "type": "local",
      "command": [
        "npx", "-y", "mcp-remote@latest",
        "https://127.0.0.1:27124/mcp/",
        "--header", "Authorization: Bearer ***TOKEN_REVOCADO***"
      ],
      "env": {
        "NODE_TLS_REJECT_UNAUTHORIZED": "0"
      },
      "timeout": 10000,
      "enabled": true
    },

    // ── HACKER-MCP-COMMANDER (Kali Linux en Docker) ─────────
    // Pentesting tools via contenedor Kali aislado.
    // Proyecto: /files/VMs/DOCKER/kali-mcp
    "hacker-mcp-commander": {
      "type": "local",
      "command": [
        "/files/VMs/DOCKER/kali-mcp/bin/kali-mcp.sh"
      ],
      "enabled": true
    }
  }
}
