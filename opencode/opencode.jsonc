{
  "$schema": "https://opencode.ai/config.json",
  "skills": {
    "paths": ["{env:HOME}/MY-AGENT-SKILLS/SKILLS"]
  },
  "agent": {
    "build": { "color": "#c62828" },
    "plan": { "color": "#8e1a1a" },
    "general": { "color": "#c5c8c6" },
    "explore": { "color": "#c62828" }
  },

  // ── Modelo principal ─────────────────────────────────────
  // "model": "ollama/qwen2.5:7b",
  // "small_model": "ollama/qwen3:1.7b",

  // ── Ollama como provider (modelos locales) ──────────────
  // Los modelos deben declararse explícitamente en "models".
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen2.5:7b": {
          "name": "Qwen 2.5 7B (local)",
          "limit": {
            "context": 32768,
            "output": 8192
          }
        },
        "qwen3:1.7b": {
          "name": "Qwen 3 1.7B (local)",
          "limit": {
            "context": 32768,
            "output": 4096
          }
        },
        "jimscard/whiterabbit-neo:latest": {
          "name": "WhiteRabbit-Neo 13B (local)",
          "limit": {
            "context": 8192,
            "output": 4096
          }
        }
      }
    }
  },

  "mcp": {
    // ── Obsidian (MCP nativo vía obsidian-local-rest-api) ────
    // Requiere plugin "obsidian-local-rest-api" (coddingtonbear) instalado
    // en TU vault de Obsidian (la URL/puerto son los que expone ese plugin
    // localmente, no una ubicacion de archivos del vault en si).
    // Cada usuario genera su propia API key desde el plugin y la define
    // como OBSIDIAN_API_KEY en su ~/.zshenv -- nunca hardcodear el valor aca.
    "obsidian": {
      "type": "http",
      "url": "https://127.0.0.1:27124/mcp/",
      "headers": {
        "Authorization": "Bearer {env:OBSIDIAN_API_KEY}"
      },
      "timeout": 10000,
      "enabled": true
    },

    // ── HACKER-MCP-COMMANDER (Kali Linux en Docker) ─────────
    // Pentesting tools via contenedor Kali aislado.
    // Proyecto: /files/VMs/DOCKER/kali-mcp
    "hacker-mcp-commander": {
      "type": "local",
      "command": [
        "/files/VMs/DOCKER/kali-mcp/bin/kali-mcp.sh"
      ],
      "enabled": true
    }
  }
}
