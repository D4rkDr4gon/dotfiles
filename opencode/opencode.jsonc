{
  "$schema": "https://opencode.ai/config.json",
  "skills": {
    "paths": ["/home/lcampassi/MY-AGENT-SKILLS/SKILLS"]
  },
  "agent": {
    "build": { "color": "#c62828" },
    "plan": { "color": "#8e1a1a" },
    "general": { "color": "#c5c8c6" },
    "explore": { "color": "#c62828" }
  },
  "mcp": {
    // ── Ollama (modelos locales de IA) ───────────────────────
    // Expone tools: ollama_generate, ollama_chat, ollama_list_models,
    // ollama_ps, ollama_embed, ollama_pull
    // Server: ~/MY-AGENT-SKILLS/MCP/ollama-server/server.py
    "ollama": {
      "type": "local",
      "command": [
        "python3",
        "/home/lcampassi/MY-AGENT-SKILLS/MCP/ollama-server/server.py"
      ],
      "enabled": true
    }

    // ── Docker ──────────────────────────────────────────────
