* {
    bg:            rgba(10, 10, 14, 0.65);
    bg-alt:        rgba(22, 22, 28, 0.82);
    fg:            #e8e8e8;
    fg-dim:        #777777;
    border-col:    rgba(255, 255, 255, 0.06);
    accent:        rgba(255, 255, 255, 0.10);
    accent-fg:     #ffffff;

    background-color: transparent;
    text-color:       @fg;
    font:             "Hack Nerd Font Mono 11";
}

window {
    background-color:   @bg;
    border:             1px;
    border-color:       @border-col;
    border-radius:      16px;
    width:              680px;
    padding:            12px;
}

mainbox {
    children:           [ inputbar, listview ];
}

inputbar {
    background-color:   @bg-alt;
    border-radius:      10px;
    padding:            14px 16px;
    margin:             0 0 8px 0;
    spacing:            12px;
    children:           [ prompt, entry ];
}

prompt {
    text-color:         @fg-dim;
    padding:            0;
}

entry {
    placeholder:        "Buscar...";
    placeholder-color:  @fg-dim;
    text-color:         @fg;
    cursor-color:       @fg;
}

listview {
    lines:              6;
    columns:            1;
    fixed-height:       0;
    scrollbar:          false;
    spacing:            2px;
}

element {
    padding:            10px 16px;
    border-radius:      10px;
}

element selected {
    background-color:   @accent;
    text-color:         @accent-fg;
}

element-text {
    vertical-align:     0.5;
    text-color:         inherit;
}

element-icon {
    size:               20px;
    padding:            0 14px 0 0;
}
